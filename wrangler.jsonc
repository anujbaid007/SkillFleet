{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillfleet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets the worker call itself, which OpenNext needs for ISR-style work.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skillfleet"
    }
  ],
  // Cloudflare Images backs next/image, so /_next/image keeps working.
  "images": {
    "binding": "IMAGES"
  },
  // Production hostnames. Cloudflare creates the DNS records and certificates
  // for these itself; they only take effect once the zone's nameservers move.
  // Keep the workers.dev URL alive alongside the custom domains: it is the
  // pre-cutover preview and a fallback if DNS ever misbehaves.
  "workers_dev": true,
  "routes": [
    { "pattern": "skillfleet.org", "custom_domain": true },
    { "pattern": "www.skillfleet.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
